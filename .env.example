# Required: your Prime Intellect API key (https://app.primeintellect.ai/dashboard/api-keys)
PRIME_API_KEY=

# Optional safety caps (defaults shown). The server will refuse to provision
# any pod whose hourly rate exceeds PRIME_MAX_HOURLY_USD or whose
# (hourly rate * max_lifetime_hours) exceeds PRIME_MAX_TOTAL_USD.
PRIME_MAX_HOURLY_USD=5
PRIME_MAX_TOTAL_USD=40

# Optional: state directory for audit log + runaway-pod tracking.
# Defaults to ~/.prime-intellect-mcp/
# PRIME_INTELLECT_MCP_STATE_DIR=

# Optional: opt in to the live smoke test. Will provision the cheapest
# available GPU (~$0.30) and terminate it. Off by default.
# PRIME_LIVE_TEST=1
